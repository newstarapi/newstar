<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>NEWSTAR X MTUAN | Futuristic Cyber API Hub & Newstar AI</title>
  <style>
    :root {
      --bg-black: #000000;
      --bg-dark-card: rgba(8, 12, 24, 0.9);
      --neon-cyan: #00f0ff;
      --neon-purple: #7000ff;
      --neon-pink: #ff007f;
      --text-primary: #f0f6fc;
      --text-dim: #8b949e;
      --border-cyber: rgba(0, 240, 255, 0.3);
      --glass-border: rgba(255, 255, 255, 0.1);
      --safe-bottom: env(safe-area-inset-bottom, 16px);
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      background-color: var(--bg-black);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      padding-bottom: calc(85px + var(--safe-bottom));
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(112, 0, 255, 0.25), transparent 70%),
        radial-gradient(circle at 80% 80%, rgba(0, 240, 255, 0.15), transparent 50%);
      background-attachment: fixed;
    }
    .hud-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-cyber);
      padding: 14px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-title {
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 1.5px;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
    }
    .status-badge {
      font-size: 11px;
      color: #00ff88;
      background: rgba(0, 255, 136, 0.1);
      padding: 4px 8px;
      border-radius: 12px;
      border: 1px solid rgba(0, 255, 136, 0.3);
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      background-color: #00ff88;
      border-radius: 50%;
      box-shadow: 0 0 8px #00ff88;
    }
    .main-container {
      padding: 16px;
      max-width: 600px;
      margin: 0 auto;
    }
    .cyber-card {
      background: var(--bg-dark-card);
      border: 1px solid var(--border-cyber);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.6);
      position: relative;
    }
    .section-title {
      font-size: 14px;
      color: var(--neon-cyan);
      letter-spacing: 1px;
      margin-bottom: 12px;
      font-weight: 700;
    }
    .chat-box {
      height: 340px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding-right: 4px;
    }
    .chat-msg {
      max-width: 85%;
      padding: 12px 16px;
      border-radius: 14px;
      font-size: 13.5px;
      line-height: 1.5;
      word-wrap: break-word;
      user-select: text;
    }
    .chat-msg.bot {
      align-self: flex-start;
      background: rgba(16, 24, 48, 0.95);
      border: 1px solid var(--glass-border);
      color: #e2e8f0;
    }
    .chat-msg.user {
      align-self: flex-end;
      background: linear-gradient(135deg, var(--neon-purple), var(--neon-pink));
      color: #ffffff;
    }
    .chat-input-wrapper {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }
    .cyber-input {
      flex: 1;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid var(--border-cyber);
      border-radius: 10px;
      padding: 12px 14px;
      color: #fff;
      font-size: 14px;
      outline: none;
    }
    .cyber-btn {
      background: linear-gradient(90deg, var(--neon-cyan), #0077ff);
      border: none;
      border-radius: 10px;
      color: #000;
      font-weight: 700;
      padding: 0 18px;
      cursor: pointer;
      font-size: 13px;
    }
    .bottom-nav {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: rgba(4, 8, 16, 0.95);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--border-cyber);
      display: flex;
      justify-content: space-around;
      padding: 10px 0 calc(10px + var(--safe-bottom));
      z-index: 1000;
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      color: var(--text-dim);
      font-size: 11px;
      cursor: pointer;
      padding: 4px 12px;
    }
    .nav-item.active {
      color: var(--neon-cyan);
      text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
    }
    .nav-icon {
      font-size: 18px;
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
    .api-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 10px;
    }
    .api-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }
    .api-name {
      font-weight: 700;
      font-size: 14px;
      color: #fff;
    }
    .method-tag {
      font-size: 10px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 4px;
      background: rgba(0, 240, 255, 0.15);
      color: var(--neon-cyan);
    }
    .api-url {
      font-size: 11px;
      color: var(--text-dim);
      word-break: break-all;
      font-family: monospace;
    }
  </style>
</head>
<body>

  <div class="hud-header">
    <div class="brand-title">NEWSTAR X MTUAN</div>
    <div class="status-badge">
      <span class="status-dot"></span> ONLINE
    </div>
  </div>

  <div class="main-container">
    <!-- TAB 1: HUB -->
    <div id="tab-hub" class="tab-content active">
      <div class="cyber-card">
        <div class="section-title">✨ NEWSTAR X MTUAN HUB</div>
        <p style="font-size: 12.5px; color: var(--text-dim); line-height: 1.6;">
          Hệ thống API Hub và Trợ lý Newstar AI. Quản lý dữ liệu trực tiếp trên thiết bị.
        </p>
      </div>
      <div class="cyber-card">
        <div class="section-title">⚡ DANH SÁCH API</div>
        <div id="api-list-container"></div>
      </div>
    </div>

    <!-- TAB 2: AI CHAT -->
    <div id="tab-ai" class="tab-content">
      <div class="cyber-card">
        <div class="section-title">🤖 NEWSTAR AI ASSISTANT</div>
        <div class="chat-box" id="chat-box">
          <div class="chat-msg bot">
            Xin chào! Tôi là <b>Newstar AI</b>. Hãy vào tab <b>🔑 API Key</b> nhập khóa Gemini để bắt đầu trò chuyện nhé!
          </div>
        </div>
        <div class="chat-input-wrapper">
          <input type="text" id="chat-input" class="cyber-input" placeholder="Nhập tin nhắn..." onkeydown="if(event.key==='Enter') sendAI()">
          <button class="cyber-btn" onclick="sendAI()">Gửi</button>
        </div>
      </div>
    </div>

    <!-- TAB 3: ADD API -->
    <div id="tab-add" class="tab-content">
      <div class="cyber-card">
        <div class="section-title">➕ THÊM API MỚI</div>
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <input type="text" id="add-title" class="cyber-input" placeholder="Tên API (Ví dụ: Weather API)">
          <input type="text" id="add-url" class="cyber-input" placeholder="Endpoint URL (https://...)">
          <select id="add-method" class="cyber-input">
            <option value="GET">GET</option>
            <option value="POST">POST</option>
            <option value="PUT">PUT</option>
            <option value="DELETE">DELETE</option>
          </select>
          <input type="text" id="add-desc" class="cyber-input" placeholder="Mô tả chức năng ngắn gọn">
          <button class="cyber-btn" style="height: 40px; margin-top: 4px;" onclick="addNewAPI()">Lưu API Mới</button>
        </div>
      </div>
    </div>

    <!-- TAB 4: API KEY -->
    <div id="tab-key" class="tab-content">
      <div class="cyber-card">
        <div class="section-title">🔑 CÀI ĐẶT API KEY</div>
        <p style="font-size: 12px; color: var(--text-dim); margin-bottom: 12px;">
          Dán Google Gemini API Key của bạn vào đây. Khóa được lưu bảo mật trên trình duyệt thiết bị.
        </p>
        <input type="password" id="gemini-key-input" class="cyber-input" style="width:100%; margin-bottom: 12px;" placeholder="Nhập API Key...">
        <button class="cyber-btn" style="width:100%; height:40px;" onclick="saveApiKey()">Lưu API Key</button>
      </div>
    </div>
  </div>

  <div class="bottom-nav">
    <div class="nav-item active" onclick="switchTab('hub', this)">
      <span class="nav-icon">🪐</span>
      <span>Hub</span>
    </div>
    <div class="nav-item" onclick="switchTab('ai', this)">
      <span class="nav-icon">🤖</span>
      <span>AI Chat</span>
    </div>
    <div class="nav-item" onclick="switchTab('add', this)">
      <span class="nav-icon">➕</span>
      <span>Thêm API</span>
    </div>
    <div class="nav-item" onclick="switchTab('key', this)">
      <span class="nav-icon">🔑</span>
      <span>API Key</span>
    </div>
  </div>

  <script>
    const defaultApis = [
      { title: "Gemini Core Pro API", url: "https://generativelanguage.googleapis.com/v1beta", method: "POST", desc: "Mô hình ngôn ngữ lớn Google Gemini" },
      { title: "Public Weather Data", url: "https://api.open-meteo.com/v1/forecast", method: "GET", desc: "Cung cấp thông tin dự báo thời tiết" }
    ];

    function getStoredApis() {
      const stored = localStorage.getItem("custom_apis");
      return stored ? JSON.parse(stored) : defaultApis;
    }

    function renderApis() {
      const apis = getStoredApis();
      const container = document.getElementById("api-list-container");
      container.innerHTML = apis.map(api => `
        <div class="api-item">
          <div class="api-header">
            <span class="api-name">${api.title}</span>
            <span class="method-tag">${api.method}</span>
          </div>
          <div class="api-url">${api.url}</div>
          <div style="font-size: 11px; color: #8b949e; margin-top: 4px;">${api.desc || ''}</div>
        </div>
      `).join('');
    }

    function switchTab(tabName, el) {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById('tab-' + tabName).classList.add('active');
      el.classList.add('active');
    }

    function saveApiKey() {
      const key = document.getElementById('gemini-key-input').value.trim();
      if(key) {
        localStorage.setItem('gemini_api_key', key);
        alert('Đã lưu API Key thành công!');
      } else {
        alert('Vui lòng nhập API Key hợp lệ!');
      }
    }

    function addNewAPI() {
      const title = document.getElementById('add-title').value.trim();
      const url = document.getElementById('add-url').value.trim();
      const method = document.getElementById('add-method').value;
      const desc = document.getElementById('add-desc').value.trim();

      if(!title || !url) {
        alert('Vui lòng điền đầy đủ Tên API và Endpoint URL!');
        return;
      }

      const apis = getStoredApis();
      apis.push({ title, url, method, desc });
      localStorage.setItem("custom_apis", JSON.stringify(apis));
      
      document.getElementById('add-title').value = '';
      document.getElementById('add-url').value = '';
      document.getElementById('add-desc').value = '';

      renderApis();
      alert('Thêm API thành công!');
      switchTab('hub', document.querySelectorAll('.nav-item')[0]);
    }

    async function sendAI() {
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if(!text) return;

      const apiKey = localStorage.getItem('gemini_api_key');
      const box = document.getElementById('chat-box');

      box.innerHTML += `<div class="chat-msg user">${text}</div>`;
      input.value = '';
      box.scrollTop = box.scrollHeight;

      if(!apiKey) {
        box.innerHTML += `<div class="chat-msg bot">⚠️ Chưa tìm thấy API Key! Vui lòng vào tab <b>🔑 API Key</b> để nhập khóa Google Gemini.</div>`;
        box.scrollTop = box.scrollHeight;
        return;
      }

      const aiMsg = document.createElement('div');
      aiMsg.className = 'chat-msg bot';
      aiMsg.innerText = 'Newstar AI đang xử lý...';
      box.appendChild(aiMsg);
      box.scrollTop = box.scrollHeight;

      // Thử gọi lần lượt các model phổ biến để tránh lỗi 404/400
      const models = ['gemini-1.5-flash', 'gemini-1.5-pro', 'gemini-pro'];
      let success = false;

      for (let model of models) {
        try {
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contents: [{ parts: [{ text: text }] }] })
          });
          const data = await response.json();
          if (data.candidates && data.candidates[0].content.parts[0].text) {
            aiMsg.innerText = data.candidates[0].content.parts[0].text;
            success = true;
            break;
          }
        } catch (e) {
          // Thử model tiếp theo nếu model này lỗi
        }
      }

      if (!success) {
        aiMsg.innerText = '⚠️ Không thể kết nối với mô hình AI. Vui lòng kiểm tra lại xem API Key của bạn đã chính xác hoặc đã được kích hoạt trên Google AI Studio chưa!';
      }
      box.scrollTop = box.scrollHeight;
    }

    window.onload = function() {
      renderApis();
      const savedKey = localStorage.getItem('gemini_api_key');
      if(savedKey) {
        document.getElementById('gemini-key-input').value = savedKey;
      }
    };
  </script>
</body>
</html>
